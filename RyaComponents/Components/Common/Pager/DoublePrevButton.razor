<RyaButton Click="async () => await ActivePageIndexChanged.InvokeAsync(1)"
           CssClass="rya-pager-button"
           Enabled="ActivePageIndex != 0"
           Visible="@NavigationButtonsVisible">
    <svg style="vertical-align: baseline" width="16" height="16" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M36 4L22 24L36 44" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M24 4L10 24L24 44" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</RyaButton>

@code {
    [Parameter]
    public EventCallback<int> ActivePageIndexChanged { get; set; }

    [Parameter]
    public int ActivePageIndex { get; set; }

    [Parameter]
    public bool NavigationButtonsVisible { get; set; }
}
