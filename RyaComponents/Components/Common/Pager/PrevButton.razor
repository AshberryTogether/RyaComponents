<RyaButton Click="async () => await ActivePageIndexChanged.InvokeAsync(Math.Max(0, ActivePageIndex - 1) + 1)"
           CssClass="rya-pager-button"
           Enabled="ActivePageIndex != 0"
           Visible="NavigationButtonsVisible">
    <svg style="vertical-align: baseline" width="16" height="16" fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path d="M30 4L16 24L30 44" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</RyaButton>

@code {
    [Parameter]
    public EventCallback<int> ActivePageIndexChanged { get; set; }

    [Parameter]
    public int ActivePageIndex { get; set; }

    [Parameter]
    public bool NavigationButtonsVisible { get; set; }
}
