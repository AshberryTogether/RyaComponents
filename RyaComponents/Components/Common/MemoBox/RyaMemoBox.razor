@using System.ComponentModel
@if (Visible)
{
    <div class="@GetCssClass()">
        <textarea placeholder="@NullText" 
            value="@_text"
            @attributes=Attributes
            @onchange=OnTextChanged
            class="rya-textarea w-100" 
            disabled="@(!Enabled)"
            readonly="@Readonly"></textarea>
        @if (ClearButtonVisible && !Readonly && Enabled)
        {
            <RyaButton Click=OnClearButtonClick
                       CssClass="d-flex align-items-center rya-clear-btn position-absolute"
                       IconCssClass="fa-regular fa-circle-xmark">
            </RyaButton>
        }
    </div>
}

@code {
    #region Fields
    private string? _text;
    #endregion

    #region Properties

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [DefaultValue(null)]
    [Parameter]
    public string? CssClass { get; set; }

    [DefaultValue(null)]
    [Parameter]
    public string? NullText { get; set; }

    [DefaultValue(false)]
    [Parameter]
    public bool ClearButtonVisible { get; set; }

    [DefaultValue(null)]
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    [DefaultValue(true)]
    [Parameter]
    public bool Visible { get; set; } = true;

    [DefaultValue(true)]
    [Parameter]
    public bool Enabled { get; set; } = true;

    [DefaultValue(false)]
    [Parameter]
    public bool Readonly { get; set; }

    #endregion

    #region Event Handlers

    private async Task OnClearButtonClick(MouseEventArgs e)
    {
        await ChangeText(string.Empty);
    }

    private async Task OnTextChanged(ChangeEventArgs e)
    {
        await ChangeText(e.Value?.ToString() ?? string.Empty);
    }

    #endregion

    #region Lifecycle Methods
    protected override async Task OnParametersSetAsync()
    {
        _text = Text;
        await base.OnParametersSetAsync();
    }
    #endregion

    #region Utility Methods
    private string GetCssClass()
    {
        return CssClassHelper.CombineCssClasses("d-flex", "rya-editor", "position-relative", CssClass);
    }

    private async Task ChangeText(string? text)
    {
        if (!Readonly && Enabled)
        {
            Text = text;
            await TextChanged.InvokeAsync(Text);
        }
    }
    #endregion
}
