@typeparam T

<RyaDropDown 
    IsVisible=Visible
    IsVisibleChanged="VisibleChanged"
    PositionTarget="@PositionTarget"
    ShowHeader=false 
    CssClass="@GetCssClasses()" 
    CloseOnOutsideClick=true>
    <BodyContent>
        <div class="d-flex flex-column">
            @foreach (T record in Data!)
            {
                <RyaButton CssClass="@GetItemCssClasses(record)" Click="async (e) => await OnItemClick(e, record)">
                    @if (ItemTemplate is null)
                    {
                        <span>@record?.ToString()</span>
                    }
                    else
                    {
                        @ItemTemplate(record)
                    }
                </RyaButton>
            }
        </div>
    </BodyContent>
</RyaDropDown>


@code 
{
    [Parameter]
    public IEnumerable<T>? Data { get; set; }

    [Parameter]
    public string PositionTarget { get; set; }

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public RenderFragment<T>? ItemTemplate { get; set; }

    [Parameter]
    public T? Value { get; set; }

    [Parameter]
    public EventCallback<T> ValueChanged { get; set; }

    [Parameter]
    public bool Enabled { get; set; }

    private async Task OnItemClick(MouseEventArgs e, T record)
    {
        Value = record;
        await ValueChanged.InvokeAsync(Value);
    }

    private string? GetCssClasses()
    {
        return CssClassHelper.CombineCssClasses("rya-drop-down");
    }

    private string? GetItemCssClasses(T item)
    {
        List<string> classes = ["rya-combo-item"];
        if (item!.Equals(Value))
        {
            classes.Add("active");
        }
        return CssClassHelper.CombineCssClasses(classes.ToArray());
    }
}
